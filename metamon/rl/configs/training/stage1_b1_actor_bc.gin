import metamon.rl.stage1_b1

# Epoch20-style actor refinement from the saved B1 Phase-2 model. The WLD head
# is frozen and its output distribution is functionally anchored during the
# update; trajectory outcomes never become per-action weights.
MetamonAMAGOExperiment.agent_type = @stage1_b1.Stage1B1Agent
MetamonAMAGOExperiment.l2_coeff = 0.001
MetamonAMAGOExperiment.learning_rate = 1e-5
MetamonAMAGOExperiment.grad_clip = 1.0
MetamonAMAGOExperiment.lr_warmup_steps = 100

stage1_b1.Stage1B1Agent.actor_bc_coef = 0.55
stage1_b1.Stage1B1Agent.actor_policy_kl_coef = 0.25
stage1_b1.Stage1B1Agent.actor_value_kl_coef = 0.20
